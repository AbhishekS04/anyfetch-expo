{
  "expo": {
    "name": "anyfetch",
    "slug": "anyfetch",
    "version": "1.0.9",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abhishek.anyfetch"
    },
    "android": {
      "versionCode": 9,
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.abhishek.anyfetch",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AnyFetch to save photos to your gallery.",
          "savePhotosPermission": "Allow AnyFetch to save photos and videos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-video"
    ]
  }
}
